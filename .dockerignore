# ===== 不该进镜像的东西 =====
# 体积大、且容器内会重新生成
.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/

# 版本控制与 IDE（镜像里用不到）
.git/
.gitignore
.gitattributes
.idea/
.vscode/

# 密钥：绝不打进镜像。运行容器时用 compose 的 environment / env_file 注入
.env

# 日志与临时产物
*.log
_*.txt

# 测试用数据与文档（运行时不需要）
data/
docs/
README.md

# 本地开发用的脚本（容器的职责是"跑服务"，不是"造数据"）
init_db.py
seed_jobs.py
create_user.py
try_analyze.py
