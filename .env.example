# 复制成 .env 后填真实值：cp .env.example .env
#
# ⚠️ 值不要加引号！
#    宿主机上 python-dotenv 会剥掉引号，但 `docker run --env-file` 不会——
#    引号会变成值的一部分，导致 base_url 变成 "https://..." 这种非法 URL。
#    统一不加引号，两边行为才一致。

# ===== 数据库（本地开发：直连宿主机 MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的密码
DB_NAME=job_tracker

# ===== 数据库（docker compose：容器内 MySQL）=====
# 只有用 `docker compose up` 时才需要这三项。
# compose 会把应用的 DB_USER/DB_PASSWORD 换成 DB_APP_USER/DB_APP_PASSWORD，
# 即「应用不使用 root」——最小权限原则：
#   DB_APP_USER 只能读写 DB_NAME 这个库，管不了其他库、也建不了用户。
DB_ROOT_PASSWORD=root的密码
DB_APP_USER=jobtracker
DB_APP_PASSWORD=应用账号的密码

# ===== 注册准入（默认关闭）=====
# REGISTER_OPEN=true 时开放注册；REGISTER_CODE 非空则要求邀请码一致
REGISTER_OPEN=false
REGISTER_CODE=

# ===== 调试（生产必须 false）=====
# true 时 500 响应会回显真实异常信息，仅限本地开发
DEBUG=false

# ===== LLM（DeepSeek，兼容 OpenAI 协议）=====
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 助手的联网搜索工具 =====
# 留空 = 不启用搜索。此时助手会明确说"搜不到"，绝不会编造公司信息。
# bocha：博查（国内直连，按量计费，支付宝可充值）
# tavily：国外，有免费额度（约 1000 次/月）
SEARCH_PROVIDER=
SEARCH_API_KEY=
